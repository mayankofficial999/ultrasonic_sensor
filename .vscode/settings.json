{
  // ============= FLUTTER CONFIGURATION =============
  "dart.flutterSdkPath": "/Users/mayanksharma/Documents/flutter",
  "dart.flutterSdkPaths": ["/Users/mayanksharma/Documents/flutter"],
  "dart.debugExternalLibraries": false,
  "dart.debugSdkLibraries": false,
  "dart.autoImportCompletions": true,
  "dart.includeDependenciesInWorkspaceSymbols": true,
  "dart.previewLsp": true,
  "dart.buildRunnerAdditionalArgs": [],

  // Flutter Hot Reload
  "dart.flutterHotReloadOnSave": "manual",
  "dart.hotReloadOnSave": "manual",

  // ============= JAVA CONFIGURATION (for Android platform code) =============
  "java.configuration.runtimes": [
    {
      "name": "JavaSE-1.8",
      "path": "/Library/Java/JavaVirtualMachines/amazon-corretto-8.jdk/Contents/Home"
    },
    {
      "name": "JavaSE-15",
      "path": "/Library/Java/JavaVirtualMachines/jdk-15.0.1.jdk/Contents/Home"
    },
    {
      "name": "JavaSE-17",
      "path": "/Library/Java/JavaVirtualMachines/jdk-17.jdk/Contents/Home",
      "default": true
    }
  ],

  // Java Language Server Configuration
  "java.jdt.ls.java.home": "/Library/Java/JavaVirtualMachines/jdk-17.jdk/Contents/Home",
  "java.home": "/Library/Java/JavaVirtualMachines/jdk-17.jdk/Contents/Home",

  // Android SDK Configuration
  "java.import.gradle.java.home": "/Library/Java/JavaVirtualMachines/jdk-17.jdk/Contents/Home",
  "java.import.gradle.enabled": true,
  "java.import.gradle.wrapper.enabled": true,

  // Flutter Plugin Project Configuration
  "java.project.sourcePaths": [
    "android/src/main/kotlin",
    "android/src/main/java"
  ],
  "java.project.outputPath": "android/build",
  "java.project.referencedLibraries": [
    "example/build/host/outputs/repo/**/*.jar",
    "example/android/app/build/intermediates/flutter/**/*.jar"
  ],
  "java.configuration.workspaceFolders": ["${workspaceFolder}/android"],
  "java.import.exclusions": [
    "**/node_modules/**",
    "**/.git/**",
    "**/build/**",
    "**/.gradle/**",
    "**/example/build/**",
    "**/.dart_tool/**"
  ],
  "java.configuration.updateBuildConfiguration": "automatic",

  // ============= TERMINAL CONFIGURATION =============
  "terminal.integrated.env.osx": {
    "JAVA_HOME": "/Library/Java/JavaVirtualMachines/jdk-17.jdk/Contents/Home",
    "ANDROID_HOME": "/Users/mayanksharma/Library/Android/sdk",
    "ANDROID_SDK_ROOT": "/Users/mayanksharma/Library/Android/sdk",
    "PATH": "/Users/mayanksharma/Documents/flutter/bin:/Users/mayanksharma/Library/Android/sdk/platform-tools:/Users/mayanksharma/Library/Android/sdk/tools:/Users/mayanksharma/Library/Android/sdk/tools/bin:/Library/Java/JavaVirtualMachines/jdk-17.jdk/Contents/Home/bin:${env:PATH}"
  },

  // ============= FLUTTER EDITOR SETTINGS =============
  "dart.lineLength": 120,
  "dart.insertArgumentPlaceholders": true,
  "dart.showTodos": true,
  "dart.renameFilesWithClasses": "prompt",
  "dart.updateImportsOnRename": true,
  "dart.warnWhenEditingFilesOutsideWorkspace": true,

  // ============= EDITOR PREFERENCES =============
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit",
    "source.fixAll": "explicit"
  },
  "editor.rulers": [80, 120],
  "editor.tabSize": 2,
  "editor.insertSpaces": true,

  // ============= FILE ASSOCIATIONS =============
  "files.associations": {
    "*.dart": "dart",
    "*.gradle": "groovy",
    "*.gradle.kts": "kotlin",
    "*.yaml": "yaml",
    "*.yml": "yaml"
  },

  // ============= FLUTTER SPECIFIC SETTINGS =============
  "dart.flutterCreateAndroidLanguage": "kotlin",
  "dart.flutterCreateIOSLanguage": "swift",
  "dart.flutterCreatePlatform": "android,ios",

  // ============= GRADLE SETTINGS (for Android platform code) =============
  "gradle.nestedProjects": true,
  "gradle.autoDetect": "on",
  "gradle.focusTaskInExplorer": true,
  "gradle.rootProject": "${workspaceFolder}/android",

  // ============= PROJECT DISCOVERY =============
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/build": true,
    "**/.gradle": true,
    "**/.dart_tool": true,
    "**/ios/Flutter/Generated.xcconfig": true,
    "**/ios/Flutter/flutter_export_environment.sh": true,
    "**/ios/ServiceDefinitions.json": true,
    "**/ios/Runner/GeneratedPluginRegistrant.*": true,
    "**/android/app/src/main/java/io/flutter/plugins/GeneratedPluginRegistrant.java": true,
    "**/android/.gradle": true,
    "**/android/captures/": true,
    "**/android/gradlew": true,
    "**/android/gradlew.bat": true,
    "**/android/local.properties": true,
    "**/android/**/GeneratedPluginRegistrant.java": true,
    "**/android/key.properties": true,
    "**/.flutter-plugins": true,
    "**/.flutter-plugins-dependencies": true
  },

  // ============= SEARCH SETTINGS =============
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/.git": true,
    "**/build": true,
    "**/.gradle": true,
    "**/.dart_tool": true,
    "**/ios/Flutter/Generated.xcconfig": true,
    "**/ios/Flutter/flutter_export_environment.sh": true,
    "**/android/gradlew": true,
    "**/android/gradlew.bat": true,
    "**/android/local.properties": true,
    "**/android/**/GeneratedPluginRegistrant.java": true,
    "**/.flutter-plugins": true,
    "**/.flutter-plugins-dependencies": true
  }
}
